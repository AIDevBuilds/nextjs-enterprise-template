# Copy to `.env` for local development. Never commit `.env`.

# ─── Server-only ────────────────────────────────────────────────────────────────
# Upstream API base URL. The Next.js BFF proxy (src/app/api/[...path]) forwards
# authenticated requests here with a Bearer token read from the httpOnly cookie.
API_URL=http://localhost:3001/api/v1
# Abort upstream calls after this many ms (prevents hung server requests).
API_TIMEOUT_MS=15000

# Auth cookie configuration (safe defaults — override only if you must).
AUTH_COOKIE_NAME=access_token
AUTH_SESSION_USER_COOKIE=session_user
AUTH_SESSION_MAX_AGE=604800
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_MAX_AGE=2592000

# ─── Client (exposed to the browser) ───────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=App

# Structured logging: debug | info | warn | error (default: debug in dev, info in prod)
NEXT_PUBLIC_LOG_LEVEL=

# Build identifier reported by /api/health (set to the git SHA in CI)
APP_VERSION=dev
