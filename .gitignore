# ── secrets ───────────────────────────────────────────────────────────────────
# Deny-by-default: every .env file is ignored, and only the committed example is
# allowed back in. A new `.env.staging` can never be committed by accident.
.env
.env.*
!.env.example

# Credentials and keys of any kind.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
secrets.json
credentials.json
serviceAccount*.json
gha-creds-*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# vercel
.vercel
